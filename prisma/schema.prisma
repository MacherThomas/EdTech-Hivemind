// EdTech Hivemind — community-led study platform.
//
// Design notes (see docs/ARCHITECTURE.md for the long version):
// - Single institution at launch, but School + SchoolDomain are data, never constants.
// - No instructor/TA role anywhere. Every user is a student; "tutor" is emergent.
// - `origin` (who authored) and `verification` (has the community vouched) are
//   first-class columns wherever content is displayed. Never derive them.
// - Individual performance data (PerformanceRecord, UserTopicProgress) is private
//   to its owner. Only the *Aggregate tables are read across users, and only
//   past a minimum-cohort threshold (k-anonymity) enforced in src/lib/privacy.ts.
// - No card numbers, bank details, national IDs or passports are ever stored.
//   Payments reference processor-side IDs only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

/// Who authored a piece of content.
enum ContentOrigin {
  COMMUNITY // a student wrote it
  AI_DRAFTED // the AI wrote it
  TUTOR // written by a student while acting as a tutor (e.g. from a session)
}

/// Whether the community has vouched for a piece of content.
enum VerificationState {
  UNVERIFIED
  COMMUNITY_VERIFIED
}

enum EnrollmentStatus {
  SELF_REPORTED
  VERIFIED // via a pluggable SSO/LMS verifier (future)
}

enum ThreadStatus {
  OPEN
  RESOLVED
}

enum ModerationState {
  VISIBLE
  FLAGGED // reputation-weighted flags crossed the review threshold; shown with a warning, excluded from AI grounding
  HIDDEN // removed from view
}

enum FlagTarget {
  THREAD
  MESSAGE
  MATERIAL
  KNOWLEDGE_ENTRY
  QUESTION
}

enum TopicSource {
  SYLLABUS // derived from an ingested syllabus
  INFERRED // inferred by the AI from materials / course name (lower confidence)
  COMMUNITY // added by a student
}

enum KnowledgeSource {
  CHAT_PROMOTION
  TUTOR_SESSION
  AI_GENERATED
  DIRECT_CONTRIBUTION
}

enum KnowledgeStability {
  TERM_STABLE // concept explanations that don't depend on professor/term
  TERM_SPECIFIC // exact formats, specific assignments — must carry an offering
}

enum KnowledgeStatus {
  ACTIVE
  FLAGGED
  DEPRECATED
}

enum MaterialKind {
  PAST_EXAM
  PROBLEM_SET
  SOLUTIONS
  NOTES
  SLIDES
  SYLLABUS
  OTHER
}

/// Academic-integrity status of a material. See src/lib/integrity.ts.
enum AssessmentStatus {
  NOT_ASSESSMENT // notes, slides, etc.
  RETIRED // a past assessment that is no longer graded — safe for practice
  POSSIBLY_LIVE // may be currently graded — AI must never surface solutions
  UNKNOWN // uploader wasn't sure — treated like POSSIBLY_LIVE
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StudySessionKind {
  LEARN
  REINFORCE // extra session inserted for a weak topic (reordering)
  RETEACH // alternative explanation after wrong answers
  RESURFACE // spaced review of a topic already answered correctly
  DEEPEN // added when the student is ahead of pace
  REVIEW // final review before the anchor date
}

enum StudySessionStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  NUMERIC
}

enum QuestionOrigin {
  AI_ORIGINAL // generated by the AI, original by default
  SOURCED_FROM_MATERIAL // taken from a real past assessment — gated by assessment status
  COMMUNITY // written by a student
}

enum TopicProgressStatus {
  UPCOMING
  IN_PROGRESS
  MASTERED
  STRUGGLING
}

enum TutoringSessionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED // funds held by the processor
  CAPTURED // released toward the tutor
  REFUNDED
  FAILED
}

enum PayoutAccountStatus {
  NOT_STARTED
  PENDING // onboarding at the processor in progress
  ACTIVE
  RESTRICTED
}

// ──────────────────────── Institution & identity ─────────────────────

model School {
  id                 String         @id @default(cuid())
  slug               String         @unique
  name               String
  timezone           String         @default("Europe/Madrid")
  /// Pluggable enrollment verifier key for this school (e.g. "lms:blackboard"). Null = self-report only.
  enrollmentVerifier String?
  domains            SchoolDomain[]
  users              User[]
  courses            Course[]
  terms              Term[]
  professors         Professor[]
  createdAt          DateTime       @default(now())
}

/// Allowlist of email domains that identify a school. Data, not a constant.
model SchoolDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // lowercase, e.g. "student.ie.edu"
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Data minimization: the only identity data kept from verification is the
/// verified email and the school it maps to.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerifiedAt DateTime
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  displayName     String
  /// Global karma — sum of per-course reputation, recomputed by jobs.
  reputation      Int      @default(0)
  createdAt       DateTime @default(now())

  sessions          AuthSession[]
  enrollments       Enrollment[]
  courseReputations CourseReputation[]
  threads           ChatThread[]
  messages          ChatMessage[]        @relation("MessageAuthor")
  votes             MessageVote[]
  flags             ContentFlag[]
  materials         Material[]
  knowledgeEntries  KnowledgeEntry[]
  knowledgeViews    KnowledgeEntryView[]
  studyPlans        StudyPlan[]
  performance       PerformanceRecord[]
  topicProgress     UserTopicProgress[]
  tutorProfile      TutorProfile?
  tutoringAsStudent TutoringSession[]    @relation("TutoringStudent")
  createdTopics     Topic[]
  questions         PracticeQuestion[]   @relation("QuestionAuthor")
}

/// One-time sign-in / verification codes. Rows are deleted on use or expiry,
/// so an unverified email never lingers.
model EmailChallenge {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────── Courses & terms ─────────────────────────

model Term {
  id        String           @id @default(cuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code      String // e.g. "2026-FALL"
  name      String // e.g. "Fall 2026"
  startsOn  DateTime
  endsOn    DateTime
  offerings CourseOffering[]

  @@unique([schoolId, code])
}

model Professor {
  id        String           @id @default(cuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  offerings CourseOffering[]
  materials Material[]

  @@unique([schoolId, name])
}

/// A course persists across terms; term-specific content hangs off CourseOffering.
model Course {
  id                 String    @id @default(cuid())
  schoolId           String
  school             School    @relation(fields: [schoolId], references: [id])
  code               String
  name               String
  description        String?
  /// Raw syllabus text, if one has been ingested.
  syllabusText       String?
  syllabusIngestedAt DateTime?
  createdAt          DateTime  @default(now())

  offerings         CourseOffering[]
  enrollments       Enrollment[]
  topics            Topic[]
  threads           ChatThread[]
  materials         Material[]
  knowledgeEntries  KnowledgeEntry[]
  studyPlans        StudyPlan[]
  questions         PracticeQuestion[]
  courseReputations CourseReputation[]
  tutorRates        TutorCourseRate[]
  tutoringSessions  TutoringSession[]

  @@unique([schoolId, code])
}

model CourseOffering {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId           String
  term             Term             @relation(fields: [termId], references: [id])
  professors       Professor[]
  enrollments      Enrollment[]
  threads          ChatThread[]
  materials        Material[]
  knowledgeEntries KnowledgeEntry[]

  @@unique([courseId, termId])
}

/// Self-reported at launch. `status`/`verifiedBy` leave room for SSO/LMS later.
/// Never stores grades or any official academic record.
model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offeringId String?
  offering   CourseOffering?  @relation(fields: [offeringId], references: [id])
  status     EnrollmentStatus @default(SELF_REPORTED)
  verifiedBy String?
  createdAt  DateTime         @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

// ──────────────────────────── Topic structure ────────────────────────

model Topic {
  id          String      @id @default(cuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  summary     String?
  position    Int         @default(0)
  source      TopicSource
  /// 0..1 — syllabus-derived ≈ 0.9, inferred ≈ 0.5. Shown to students.
  confidence  Float       @default(0.5)
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])

  prerequisites Topic[] @relation("TopicPrerequisites")
  dependents    Topic[] @relation("TopicPrerequisites")

  threads          ChatThread[]
  materials        Material[]
  knowledgeEntries KnowledgeEntry[]
  questions        PracticeQuestion[]
  studySessions    StudySessionTopic[]
  performance      PerformanceRecord[]
  progress         UserTopicProgress[]
  aggregate        TopicAggregate?

  @@unique([courseId, name])
}

// ───────────────────────────────── Chat ──────────────────────────────

model ChatThread {
  id                String          @id @default(cuid())
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offeringId        String?
  offering          CourseOffering? @relation(fields: [offeringId], references: [id])
  topicId           String?
  topic             Topic?          @relation(fields: [topicId], references: [id])
  /// Optional link to the material the question is about; drives the live/retired gate.
  materialId        String?
  material          Material?       @relation(fields: [materialId], references: [id])
  authorId          String
  author            User            @relation(fields: [authorId], references: [id])
  title             String
  body              String
  status            ThreadStatus    @default(OPEN)
  resolvedMessageId String?         @unique
  /// Who marked the resolving answer (asker or a high-reputation member).
  resolvedById      String?
  /// True while the "AI answers first" draft is being generated.
  aiAnswerPending   Boolean         @default(false)
  resolvedMessage   ChatMessage?    @relation("ResolvedAnswer", fields: [resolvedMessageId], references: [id])
  moderation        ModerationState @default(VISIBLE)
  createdAt         DateTime        @default(now())
  lastActivityAt    DateTime        @default(now())

  messages ChatMessage[] @relation("ThreadMessages")

  @@index([courseId, lastActivityAt])
}

model ChatMessage {
  id                 String            @id @default(cuid())
  threadId           String
  thread             ChatThread        @relation("ThreadMessages", fields: [threadId], references: [id], onDelete: Cascade)
  /// Null when origin = AI_DRAFTED.
  authorId           String?
  author             User?             @relation("MessageAuthor", fields: [authorId], references: [id])
  origin             ContentOrigin
  verification       VerificationState @default(UNVERIFIED)
  body               String
  /// Denormalized net vote score, recomputed on each vote.
  score              Int               @default(0)
  /// For AI drafts: which knowledge entries grounded it (ids), so the UI can cite them.
  groundedOnEntryIds String[]          @default([])
  /// AI flagged that it couldn't tell whether the related assessment is live.
  integrityNote      String?
  moderation         ModerationState   @default(VISIBLE)
  createdAt          DateTime          @default(now())

  votes          MessageVote[]
  resolvesThread ChatThread?     @relation("ResolvedAnswer")
  promotedEntry  KnowledgeEntry? @relation("PromotedFrom")

  @@index([threadId, createdAt])
}

model MessageVote {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  value     Int // +1 or -1
  createdAt DateTime    @default(now())

  @@id([userId, messageId])
}

/// Community flags on any content. Reputation-weighted review in src/jobs/moderation.ts.
model ContentFlag {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FlagTarget
  targetId   String
  reason     String
  /// Reputation weight of the flagger at the time of flagging.
  weight     Float      @default(1)
  createdAt  DateTime   @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// ─────────────────────────────── Materials ───────────────────────────

model Material {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploaderId       String
  uploader         User             @relation(fields: [uploaderId], references: [id])
  title            String
  description      String?
  kind             MaterialKind
  offeringId       String?
  offering         CourseOffering?  @relation(fields: [offeringId], references: [id])
  professorId      String?
  professor        Professor?       @relation(fields: [professorId], references: [id])
  assessmentStatus AssessmentStatus
  storageKey       String
  fileName         String
  mimeType         String
  sizeBytes        Int
  /// Plain text extracted at upload (text-like files only) for grounding. Never
  /// passed to the AI when the material is POSSIBLY_LIVE/UNKNOWN.
  extractedText    String?
  moderation       ModerationState  @default(VISIBLE)
  createdAt        DateTime         @default(now())

  topics           Topic[]
  threads          ChatThread[]
  knowledgeEntries KnowledgeEntry[]   @relation("EntryAssessment")
  sourcedQuestions PracticeQuestion[]

  @@index([courseId, createdAt])
}

// ──────────────────────────────── Hivemind ───────────────────────────

model KnowledgeEntry {
  id                    String             @id @default(cuid())
  courseId              String
  course                Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId               String?
  topic                 Topic?             @relation(fields: [topicId], references: [id])
  title                 String
  body                  String
  origin                ContentOrigin
  verification          VerificationState
  source                KnowledgeSource
  stability             KnowledgeStability @default(TERM_STABLE)
  /// Required when stability = TERM_SPECIFIC (enforced in src/lib/hivemind.ts).
  offeringId            String?
  offering              CourseOffering?    @relation(fields: [offeringId], references: [id])
  /// If this entry essentially answers a graded question, link the assessment.
  /// The entry then inherits that material's live/retired gate.
  assessmentMaterialId  String?
  assessmentMaterial    Material?          @relation("EntryAssessment", fields: [assessmentMaterialId], references: [id])
  status                KnowledgeStatus    @default(ACTIVE)
  contributorId         String?
  contributor           User?              @relation(fields: [contributorId], references: [id])
  promotedFromMessageId String?            @unique
  promotedFromMessage   ChatMessage?       @relation("PromotedFrom", fields: [promotedFromMessageId], references: [id])
  /// Versioning: a newer entry supersedes an older one (e.g. new professor).
  version               Int                @default(1)
  supersedesId          String?            @unique
  supersedes            KnowledgeEntry?    @relation("EntryVersions", fields: [supersedesId], references: [id])
  supersededBy          KnowledgeEntry?    @relation("EntryVersions")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  views KnowledgeEntryView[]

  @@index([courseId, topicId, status])
}

/// Private per-user read log, used only in aggregate to estimate entry helpfulness.
model KnowledgeEntryView {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId  String
  entry    KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  viewedAt DateTime       @default(now())

  @@index([entryId])
}

// ─────────────────────────────── Study guide ─────────────────────────

model StudyPlan {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  anchorLabel      String // e.g. "Midterm"
  anchorDate       DateTime
  status           PlanStatus @default(ACTIVE)
  /// Minutes per day the student said they can study.
  dailyMinutes     Int        @default(60)
  /// "normal" | "compressed" | "deepening" — last pace decision, explained in paceReason.
  paceMode         String     @default("normal")
  paceReason       String?
  adaptationCycles Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions StudySession[]
  progress UserTopicProgress[]

  @@index([userId, courseId])
}

model StudySession {
  id               String             @id @default(cuid())
  planId           String
  plan             StudyPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  position         Int
  scheduledFor     DateTime
  title            String
  kind             StudySessionKind   @default(LEARN)
  status           StudySessionStatus @default(UPCOMING)
  /// Human-readable "why this session is here" — shown in the progress view.
  reason           String
  /// Target question difficulty 1..5 (raised for DEEPEN sessions).
  targetDifficulty Int                @default(2)
  completedAt      DateTime?

  topics    StudySessionTopic[]
  questions StudySessionQuestion[]
  attempts  PerformanceRecord[]

  @@index([planId, position])
}

model StudySessionTopic {
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([sessionId, topicId])
}

model PracticeQuestion {
  id               String          @id @default(cuid())
  courseId         String
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId          String
  topic            Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type             QuestionType
  /// Intended difficulty 1..5; compare with QuestionAggregate for calibration.
  difficulty       Int
  prompt           String
  /// For MULTIPLE_CHOICE: array of strings.
  choices          Json?
  answer           String
  explanation      String
  origin           QuestionOrigin
  sourceMaterialId String?
  sourceMaterial   Material?       @relation(fields: [sourceMaterialId], references: [id])
  /// Student who wrote it (COMMUNITY / SOURCED_FROM_MATERIAL); null for AI questions.
  authorId         String?
  author           User?           @relation("QuestionAuthor", fields: [authorId], references: [id])
  moderation       ModerationState @default(VISIBLE)
  createdAt        DateTime        @default(now())

  sessions  StudySessionQuestion[]
  attempts  PerformanceRecord[]
  aggregate QuestionAggregate?

  @@index([courseId, topicId])
}

model StudySessionQuestion {
  sessionId  String
  session    StudySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int

  @@id([sessionId, questionId])
}

/// PRIVATE to the user. Never read across users except by aggregate jobs.
model PerformanceRecord {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionId String
  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    StudySession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  response   String
  correct    Boolean
  answeredAt DateTime         @default(now())

  @@index([userId, topicId])
}

/// PRIVATE per-user, per-topic state driving the adaptive mechanisms.
model UserTopicProgress {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               StudyPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status             TopicProgressStatus @default(UPCOMING)
  /// Exponentially-weighted accuracy 0..1.
  mastery            Float               @default(0)
  attempts           Int                 @default(0)
  /// How many times the plan was adjusted for this topic without improvement.
  stalledCycles      Int                 @default(0)
  /// Mastery at the previous adaptation cycle — used to detect "not improving".
  masteryAtLastCycle Float?
  /// Spaced resurfacing interval.
  intervalDays       Int                 @default(1)
  nextReviewAt       DateTime?
  lastReason         String?

  @@unique([planId, topicId])
}

/// Course-level aggregates. Only these may be shown to other users.
model TopicAggregate {
  topicId       String   @id
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts      Int      @default(0)
  correct       Int      @default(0)
  distinctUsers Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model QuestionAggregate {
  questionId    String           @id
  question      PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts      Int              @default(0)
  correct       Int              @default(0)
  distinctUsers Int              @default(0)
  updatedAt     DateTime         @updatedAt
}

// ───────────────────────── Reputation & tutoring ─────────────────────

/// The underlying signals for per-course reputation. Tutor visibility is
/// computed from these against tunable thresholds (src/lib/reputation.ts).
model CourseReputation {
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  upvotesReceived    Int      @default(0)
  downvotesReceived  Int      @default(0)
  answersPosted      Int      @default(0)
  resolvedAnswers    Int      @default(0)
  entriesContributed Int      @default(0)
  sessionsCompleted  Int      @default(0)
  ratingSum          Int      @default(0)
  ratingCount        Int      @default(0)
  /// Upheld flags against this user's content.
  flagsUpheld        Int      @default(0)
  score              Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@id([userId, courseId])
  @@index([courseId, score])
}

/// Tutor identity spans courses; the only UI today is per course.
/// No application or vetting — eligibility per course comes from reputation.
model TutorProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  timezone         String              @default("Europe/Madrid")
  active           Boolean             @default(true)
  /// Processor-side connected-account reference only. Never bank details.
  payoutProvider   String?
  payoutAccountRef String?
  payoutStatus     PayoutAccountStatus @default(NOT_STARTED)
  createdAt        DateTime            @default(now())

  rates        TutorCourseRate[]
  availability TutorAvailability[]
  sessions     TutoringSession[]
}

/// Tutors set their own price per course. Not a platform constant.
model TutorCourseRate {
  id             String       @id @default(cuid())
  tutorId        String
  tutor          TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Price in minor units (cents) for one session of `sessionMinutes`.
  priceCents     Int
  currency       String       @default("EUR")
  sessionMinutes Int          @default(60)
  active         Boolean      @default(true)

  @@unique([tutorId, courseId])
}

/// Weekly recurring availability window in the tutor's timezone.
model TutorAvailability {
  id          String       @id @default(cuid())
  tutorId     String
  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday
  startMinute Int // minutes from midnight
  endMinute   Int
}

model TutoringSession {
  id                 String                @id @default(cuid())
  tutorId            String
  tutor              TutorProfile          @relation(fields: [tutorId], references: [id])
  studentId          String
  student            User                  @relation("TutoringStudent", fields: [studentId], references: [id])
  courseId           String
  course             Course                @relation(fields: [courseId], references: [id])
  scheduledStart     DateTime
  durationMinutes    Int
  status             TutoringSessionStatus @default(REQUESTED)
  /// Snapshotted at booking so later rate changes don't affect this session.
  priceCents         Int
  currency           String
  studentNote        String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  /// Whether the cancellation fell inside the free window (full refund).
  refundEligible     Boolean?
  disputeOpenedAt    DateTime?
  disputeOpenedById  String?
  disputeReason      String?
  disputeResolvedAt  DateTime?
  disputeResolution  String?
  rating             Int?
  review             String?
  reviewedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  payment Payment?

  @@index([tutorId, scheduledStart])
  @@index([studentId, scheduledStart])
}

/// References to processor-side objects only. No card or bank data, ever.
model Payment {
  id                 String          @id @default(cuid())
  sessionId          String          @unique
  session            TutoringSession @relation(fields: [sessionId], references: [id])
  provider           String // "mock" | "stripe_connect" (pending IE legal/finance checkpoint)
  providerPaymentRef String?
  status             PaymentStatus   @default(PENDING)
  amountCents        Int
  platformFeeCents   Int             @default(0)
  currency           String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

/// Audit log of background job runs (the job module is synchronous for now).
model JobRun {
  id         String   @id @default(cuid())
  name       String
  payload    Json
  status     String // "ok" | "error"
  error      String?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
}
