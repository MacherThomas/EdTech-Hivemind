# Local development only. Hosting/data residency for anything beyond local dev
# must be reviewed with IE Cloud Services first (see docs/CHECKPOINTS.md).
DATABASE_URL="postgresql://hivemind:hivemind@localhost:5432/hivemind"

# HMAC key for sign-in codes and session tokens. Required in production
# (generate with: openssl rand -base64 32).
AUTH_SECRET=""

# Optional. Without it the app runs a deterministic offline AI stub so the
# whole product works locally; every AI output is still labeled AI-drafted.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# Where uploaded materials are stored (local disk adapter).
UPLOAD_DIR="./uploads"

# Email delivery. "console" logs verification codes to the server console.
EMAIL_TRANSPORT="console"

# Payments. "mock" simulates a processor; no real money moves. The real
# processor adapter is intentionally not wired until the payout structure for
# student tutors is confirmed with IE legal/finance (docs/CHECKPOINTS.md).
PAYMENTS_PROVIDER="mock"
